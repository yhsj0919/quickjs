{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickjs-ui.local/quickjs_ui.schema.json",
  "title": "quickjs_ui UI schema",
  "description": "Serializable UI node schema rendered by package:quickjs_ui.",
  "$ref": "#/$defs/node",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" },
      "properties": {
        "action": { "type": "string" },
        "method": { "type": "string" },
        "payload": { "$ref": "#/$defs/jsonValue" },
        "source": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "anyOf": [
        { "required": ["action"] },
        { "required": ["method"] }
      ]
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/elevatedButton" },
        { "$ref": "#/$defs/textButton" },
        { "$ref": "#/$defs/outlinedButton" },
        { "$ref": "#/$defs/iconButton" },
        { "$ref": "#/$defs/inkWell" },
        { "$ref": "#/$defs/floatingActionButton" },
        { "$ref": "#/$defs/row" },
        { "$ref": "#/$defs/column" },
        { "$ref": "#/$defs/container" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/svg" },
        { "$ref": "#/$defs/canvas" },
        { "$ref": "#/$defs/snapshotBoundary" },
        { "$ref": "#/$defs/listView" },
        { "$ref": "#/$defs/listViewBuilder" },
        { "$ref": "#/$defs/singleChildScrollView" },
        { "$ref": "#/$defs/gridView" },
        { "$ref": "#/$defs/pageView" },
        { "$ref": "#/$defs/refreshIndicator" },
        { "$ref": "#/$defs/textField" },
        { "$ref": "#/$defs/gestureDetector" },
        { "$ref": "#/$defs/stack" },
        { "$ref": "#/$defs/positioned" },
        { "$ref": "#/$defs/padding" },
        { "$ref": "#/$defs/margin" },
        { "$ref": "#/$defs/align" },
        { "$ref": "#/$defs/center" },
        { "$ref": "#/$defs/sizedBox" },
        { "$ref": "#/$defs/expanded" },
        { "$ref": "#/$defs/flexible" },
        { "$ref": "#/$defs/spacer" },
        { "$ref": "#/$defs/wrap" },
        { "$ref": "#/$defs/aspectRatio" },
        { "$ref": "#/$defs/constrainedBox" },
        { "$ref": "#/$defs/safeArea" },
        { "$ref": "#/$defs/form" },
        { "$ref": "#/$defs/checkbox" },
        { "$ref": "#/$defs/switch" },
        { "$ref": "#/$defs/slider" },
        { "$ref": "#/$defs/radio" },
        { "$ref": "#/$defs/dropdownButton" },
        { "$ref": "#/$defs/icon" },
        { "$ref": "#/$defs/divider" },
        { "$ref": "#/$defs/verticalDivider" },
        { "$ref": "#/$defs/placeholder" },
        { "$ref": "#/$defs/tooltip" },
        { "$ref": "#/$defs/card" },
        { "$ref": "#/$defs/clipRRect" },
        { "$ref": "#/$defs/backdropFilter" },
        { "$ref": "#/$defs/decoratedBox" },
        { "$ref": "#/$defs/richText" },
        { "$ref": "#/$defs/scaffold" },
        { "$ref": "#/$defs/appBar" },
        { "$ref": "#/$defs/bottomNavigationBar" },
        { "$ref": "#/$defs/tabBar" },
        { "$ref": "#/$defs/tabBarView" },
        { "$ref": "#/$defs/drawer" },
        { "$ref": "#/$defs/circularProgressIndicator" },
        { "$ref": "#/$defs/linearProgressIndicator" },
        { "$ref": "#/$defs/snackBar" },
        { "$ref": "#/$defs/alertDialog" },
        { "$ref": "#/$defs/bottomSheet" },
        { "$ref": "#/$defs/animatedAlign" },
        { "$ref": "#/$defs/animatedContainer" },
        { "$ref": "#/$defs/animatedOpacity" },
        { "$ref": "#/$defs/animatedPadding" },
        { "$ref": "#/$defs/animatedSwitcher" },
        { "$ref": "#/$defs/hero" }
      ]
    },
    "baseNode": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": { "$ref": "#/$defs/jsonValue" },
      "properties": {
        "type": { "type": "string" },
        "key": { "type": "string" },
        "semanticLabel": { "type": "string" },
        "semanticsLabel": { "type": "string" },
        "semanticHint": { "type": "string" },
        "tooltip": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["button", "image", "textField", "header"]
        },
        "enabled": { "type": "boolean" },
        "focusOrder": { "type": "number" },
        "opacity": { "$ref": "#/$defs/animatedNumber" },
        "transform": { "$ref": "#/$defs/nodeTransform" },
        "clipRadius": { "$ref": "#/$defs/animatedNumber" },
        "clipBehavior": {
          "type": "string",
          "enum": ["none", "hardEdge", "antiAlias", "antiAliasWithSaveLayer"]
        },
        "blur": { "$ref": "#/$defs/blurEffect" },
        "backdropBlur": { "$ref": "#/$defs/blurEffect" },
        "colorFilter": {
          "type": "object",
          "required": ["color"],
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "blendMode": { "type": "string" }
          }
        },
        "paused": { "type": "boolean" },
        "playToken": { "$ref": "#/$defs/jsonValue" },
        "reverse": { "type": "boolean" },
        "onAnimationEnd": { "$ref": "#/$defs/event" },
        "onTap": { "$ref": "#/$defs/event" },
        "onLongPress": { "$ref": "#/$defs/event" },
        "onDoubleTap": { "$ref": "#/$defs/event" },
        "onDragStart": { "$ref": "#/$defs/event" },
        "onDragUpdate": { "$ref": "#/$defs/event" },
        "onDragEnd": { "$ref": "#/$defs/event" },
        "onSwipe": { "$ref": "#/$defs/event" },
        "child": { "$ref": "#/$defs/node" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "not": {
        "required": ["child", "children"]
      }
    },
    "animatedNumber": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "required": ["from", "to", "durationMs"],
          "properties": {
            "from": { "type": "number" },
            "to": { "type": "number" },
            "durationMs": { "type": "number", "exclusiveMinimum": 0 },
            "delayMs": { "type": "number" },
            "phaseMs": { "type": "number" },
            "repeat": { "type": "boolean" },
            "autoreverse": { "type": "boolean" },
            "timeSource": { "type": "string", "enum": ["elapsed", "epoch"] },
            "curve": {
              "type": "string",
              "enum": ["linear", "easeIn", "easeOut", "easeInOut"]
            }
          }
        }
      ]
    },
    "controlVisualStyle": {
      "type": "object",
      "properties": {
        "backgroundColor": { "$ref": "#/$defs/color" },
        "foregroundColor": { "$ref": "#/$defs/color" },
        "overlayColor": { "$ref": "#/$defs/color" },
        "shadowColor": { "$ref": "#/$defs/color" },
        "surfaceTintColor": { "$ref": "#/$defs/color" },
        "borderColor": { "$ref": "#/$defs/color" },
        "borderWidth": { "type": "number", "minimum": 0 },
        "borderRadius": { "$ref": "#/$defs/borderRadius" },
        "elevation": { "type": "number" },
        "padding": { "$ref": "#/$defs/edgeInsets" },
        "textStyle": { "$ref": "#/$defs/textStyle" },
        "fillColor": { "$ref": "#/$defs/color" },
        "thumbColor": { "$ref": "#/$defs/color" },
        "trackColor": { "$ref": "#/$defs/color" },
        "activeTrackColor": { "$ref": "#/$defs/color" },
        "inactiveTrackColor": { "$ref": "#/$defs/color" },
        "trackOutlineColor": { "$ref": "#/$defs/color" },
        "trackOutlineWidth": { "type": "number", "minimum": 0 },
        "valueIndicatorColor": { "$ref": "#/$defs/color" },
        "trackHeight": { "type": "number", "exclusiveMinimum": 0 },
        "thumbRadius": { "type": "number", "minimum": 0 },
        "overlayRadius": { "type": "number", "minimum": 0 },
        "color": { "$ref": "#/$defs/color" },
        "activeColor": { "$ref": "#/$defs/color" },
        "inactiveColor": { "$ref": "#/$defs/color" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "minimum": 0 }
      }
    },
    "controlStateStyles": {
      "type": "object",
      "properties": {
        "normal": { "$ref": "#/$defs/controlVisualStyle" },
        "hovered": { "$ref": "#/$defs/controlVisualStyle" },
        "focused": { "$ref": "#/$defs/controlVisualStyle" },
        "selected": { "$ref": "#/$defs/controlVisualStyle" },
        "pressed": { "$ref": "#/$defs/controlVisualStyle" },
        "disabled": { "$ref": "#/$defs/controlVisualStyle" }
      }
    },
    "controlSlots": {
      "type": "object",
      "properties": {
        "stateStyles": { "$ref": "#/$defs/controlStateStyles" },
        "thumbStyle": { "$ref": "#/$defs/controlStateStyles" },
        "trackStyle": { "$ref": "#/$defs/controlStateStyles" },
        "overlayStyle": { "$ref": "#/$defs/controlStateStyles" }
      }
    },
    "nodeTransform": {
      "type": "object",
      "properties": {
        "translate": {
          "type": "object",
          "properties": {
            "x": { "$ref": "#/$defs/animatedNumber" },
            "y": { "$ref": "#/$defs/animatedNumber" }
          }
        },
        "scale": {
          "oneOf": [
            { "$ref": "#/$defs/animatedNumber" },
            {
              "type": "object",
              "properties": {
                "x": { "$ref": "#/$defs/animatedNumber" },
                "y": { "$ref": "#/$defs/animatedNumber" }
              }
            }
          ]
        },
        "rotate": { "$ref": "#/$defs/animatedNumber" },
        "alignment": { "type": "string" }
      }
    },
    "blurEffect": {
      "oneOf": [
        { "$ref": "#/$defs/animatedNumber" },
        {
          "type": "object",
          "properties": {
            "sigma": { "$ref": "#/$defs/animatedNumber" },
            "sigmaX": { "$ref": "#/$defs/animatedNumber" },
            "sigmaY": { "$ref": "#/$defs/animatedNumber" }
          }
        }
      ]
    },
    "edgeInsets": {
      "oneOf": [
        { "$ref": "#/$defs/space" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": { "$ref": "#/$defs/space" },
            "value": { "$ref": "#/$defs/space" },
            "left": { "$ref": "#/$defs/space" },
            "top": { "$ref": "#/$defs/space" },
            "right": { "$ref": "#/$defs/space" },
            "bottom": { "$ref": "#/$defs/space" },
            "horizontal": { "$ref": "#/$defs/space" },
            "vertical": { "$ref": "#/$defs/space" }
          }
        }
      ]
    },
    "borderRadius": {
      "oneOf": [
        { "$ref": "#/$defs/radius" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": { "$ref": "#/$defs/radius" },
            "radius": { "$ref": "#/$defs/radius" },
            "topLeft": { "$ref": "#/$defs/radius" },
            "topRight": { "$ref": "#/$defs/radius" },
            "bottomLeft": { "$ref": "#/$defs/radius" },
            "bottomRight": { "$ref": "#/$defs/radius" }
          }
        }
      ]
    },
    "space": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^\\$(space\\.|spacing\\.)?[A-Za-z][A-Za-z0-9.]*$"
        }
      ]
    },
    "radius": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^\\$(radius\\.|radii\\.)?[A-Za-z][A-Za-z0-9.]*$"
        }
      ]
    },
    "elevation": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^\\$(elevation\\.|shadow\\.)?[A-Za-z][A-Za-z0-9.]*$"
        }
      ]
    },
    "color": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^(#|0x|0X)?[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        {
          "type": "string",
          "pattern": "^\\$(theme\\.|color\\.|colors\\.)?[A-Za-z][A-Za-z0-9.]*$"
        }
      ]
    },
    "textStyle": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\$(text\\.|textTheme\\.)?[A-Za-z][A-Za-z0-9.]*$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "fontSize": { "$ref": "#/$defs/space" },
            "fontWeight": {
              "oneOf": [
                { "type": "number", "enum": [100, 200, 300, 400, 500, 600, 700, 800, 900] },
                {
                  "type": "string",
                  "enum": ["normal", "bold", "w100", "w200", "w300", "w400", "w500", "w600", "w700", "w800", "w900"]
                }
              ]
            },
            "letterSpacing": { "$ref": "#/$defs/space" },
            "height": { "type": "number" }
          }
        }
      ]
    },
    "boxDecoration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "borderRadius": { "$ref": "#/$defs/borderRadius" },
        "border": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "width": { "$ref": "#/$defs/space" }
          }
        }
      }
    },
    "resource": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["uri"] },
            { "required": ["url"] },
            { "required": ["src"] },
            { "required": ["source"] },
            { "required": ["path"] }
          ],
          "properties": {
            "uri": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "src": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "kind": {
              "type": "string",
              "enum": ["asset", "file", "network", "http", "https", "data", "custom"]
            },
            "type": {
              "type": "string",
              "enum": ["asset", "file", "network", "http", "https", "data", "custom"]
            },
            "mimeType": { "type": "string" },
            "mime": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "checksum": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "cacheKey": { "type": "string" },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      ]
    },
    "curve": {
      "type": "string",
      "enum": [
        "linear",
        "ease",
        "easeIn",
        "easeOut",
        "easeInOut",
        "fastOutSlowIn",
        "bounceIn",
        "bounceOut",
        "elasticIn",
        "elasticOut"
      ]
    },
    "scrollable": {
      "type": "object",
      "properties": {
        "initialScrollOffset": { "type": "number" },
        "scrollToOffset": { "type": "number" },
        "scrollToKey": { "type": "string" },
        "scrollToken": { "type": "integer", "minimum": 0 },
        "scrollToToken": { "type": "integer", "minimum": 0 },
        "scrollDurationMs": { "type": "integer", "minimum": 0 },
        "scrollCurve": { "$ref": "#/$defs/curve" },
        "onScroll": { "$ref": "#/$defs/event" }
      }
    },
    "singleChild": {
      "type": "object",
      "properties": {
        "child": { "$ref": "#/$defs/node" }
      }
    },
    "multiChild": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "text": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Text" },
            "data": { "type": "string" },
            "text": { "type": "string" },
            "textAlign": {
              "type": "string",
              "enum": ["left", "right", "center", "justify", "start", "end"]
            },
            "style": { "$ref": "#/$defs/textStyle" }
          }
        }
      ]
    },
    "elevatedButton": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        { "$ref": "#/$defs/singleChild" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "ElevatedButton" },
            "label": { "type": "string" },
            "leading": { "$ref": "#/$defs/node" },
            "content": { "$ref": "#/$defs/node" },
            "trailing": { "$ref": "#/$defs/node" },
            "gap": { "$ref": "#/$defs/space" },
            "stateStyles": { "$ref": "#/$defs/controlStateStyles" },
            "onPressed": { "$ref": "#/$defs/event" }
          }
        }
      ]
    },
    "flex": {
      "allOf": [
        { "$ref": "#/$defs/multiChild" },
        {
          "type": "object",
          "properties": {
            "mainAxisAlignment": {
              "type": "string",
              "enum": ["start", "end", "center", "spaceBetween", "spaceAround", "spaceEvenly"]
            },
            "crossAxisAlignment": {
              "type": "string",
              "enum": ["start", "end", "center", "stretch", "baseline"]
            },
            "gap": { "$ref": "#/$defs/space" }
          }
        }
      ]
    },
    "row": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        { "$ref": "#/$defs/flex" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Row" }
          }
        }
      ]
    },
    "column": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        { "$ref": "#/$defs/flex" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Column" }
          }
        }
      ]
    },
    "container": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        { "$ref": "#/$defs/singleChild" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Container" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "padding": { "$ref": "#/$defs/edgeInsets" },
            "margin": { "$ref": "#/$defs/edgeInsets" },
            "alignment": {
              "type": "string",
              "enum": ["topLeft", "topCenter", "topRight", "centerLeft", "center", "centerRight", "bottomLeft", "bottomCenter", "bottomRight"]
            },
            "color": { "$ref": "#/$defs/color" },
            "backgroundColor": { "$ref": "#/$defs/color" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "decoration": { "$ref": "#/$defs/boxDecoration" },
            "borderRadius": { "$ref": "#/$defs/borderRadius" },
            "borderColor": { "$ref": "#/$defs/color" },
            "borderWidth": { "$ref": "#/$defs/space" },
            "elevation": { "$ref": "#/$defs/elevation" }
          }
        }
      ]
    },
    "image": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "anyOf": [
            { "required": ["src"] },
            { "required": ["source"] },
            { "required": ["uri"] },
            { "required": ["url"] },
            { "required": ["path"] }
          ],
          "properties": {
            "type": { "const": "Image" },
            "src": { "$ref": "#/$defs/resource" },
            "source": { "$ref": "#/$defs/resource" },
            "uri": { "$ref": "#/$defs/resource" },
            "url": { "$ref": "#/$defs/resource" },
            "path": { "$ref": "#/$defs/resource" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "fit": {
              "type": "string",
              "enum": ["fill", "contain", "cover", "fitWidth", "fitHeight", "none", "scaleDown"]
            },
            "cacheWidth": { "type": "integer", "minimum": 1 },
            "cacheHeight": { "type": "integer", "minimum": 1 },
            "filterQuality": {
              "type": "string",
              "enum": ["none", "low", "medium", "high"]
            },
            "gaplessPlayback": { "type": "boolean" },
            "excludeFromSemantics": { "type": "boolean" }
          }
        }
      ]
    },
    "svg": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "anyOf": [
            { "required": ["src"] },
            { "required": ["source"] },
            { "required": ["uri"] },
            { "required": ["url"] },
            { "required": ["path"] },
            { "required": ["data"] },
            { "required": ["string"] },
            { "required": ["svg"] }
          ],
          "properties": {
            "type": { "const": "Svg" },
            "src": { "$ref": "#/$defs/resource" },
            "source": { "$ref": "#/$defs/resource" },
            "uri": { "$ref": "#/$defs/resource" },
            "url": { "$ref": "#/$defs/resource" },
            "path": { "$ref": "#/$defs/resource" },
            "data": { "type": "string", "minLength": 1 },
            "string": { "type": "string", "minLength": 1 },
            "svg": { "type": "string", "minLength": 1 },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "fit": {
              "type": "string",
              "enum": ["fill", "contain", "cover", "fitWidth", "fitHeight", "none", "scaleDown"]
            },
            "color": { "$ref": "#/$defs/color" },
            "excludeFromSemantics": { "type": "boolean" }
          }
        }
      ]
    },
    "canvas": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "Canvas" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 },
            "backgroundColor": { "$ref": "#/$defs/color" },
            "sceneKey": { "type": "string", "minLength": 1 },
            "resources": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "paused": { "type": "boolean" },
            "playToken": { "$ref": "#/$defs/jsonValue" },
